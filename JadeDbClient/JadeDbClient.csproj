<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>JadeDbClient</PackageId>
    <Version>1.7.00</Version> 
    <Authors>KausCoder</Authors>
    <Description>Simplified ADO.NET-style access for SQL Server, MySQL, PostgreSQL. Unified API, parameterized queries, fluent builder, dialect-aware paging and identity handling, multiple connection support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/KaustavCodes/JadeDbClient-DotNet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JadeDbClient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="14.0.1-beta2" />
    <PackageReference Include="Npgsql" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" Link="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Attributes/" />
    <Folder Include="Enums/" />
    <Folder Include="Helpers/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the generator to include it in the build -->
    <ProjectReference Include="../JadeDbClient.SourceGenerator/JadeDbClient.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    
    <!-- Pack the generator DLL into the 'analyzers/dotnet/cs' folder of the NuGet package -->
    <None Include="..\JadeDbClient.SourceGenerator\bin\Release\netstandard2.0\JadeDbClient.SourceGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>

